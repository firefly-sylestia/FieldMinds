<?xml version="1.0" encoding="utf-8"?>
<!--
  Glassmorphic widget background — matches the compass/level aesthetic.
  
  Multi-layer approach (no runtime blur, since RemoteViews cannot use Haze):
    1) Base gradient — subtle depth gradient across the card surface
    2) Glass surface — semi-transparent frosted overlay with the theme's surface tint
    3) Primary specular glow — radial gradient mimicking the AGSL liquid-glass
       highlight spot (top-left, like the compass rose specular)
    4) Secondary glow — subtle Fresnel-like radiance at bottom-right
    5) Border — thin translucent outline with rounded corners
  
  All colors reference widget_colors.xml which provides automatic light/dark switching.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1) Base gradient layer — diagonal depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/widget_surface_container"
                android:endColor="@color/widget_surface_container_low"
                android:type="linear" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- 2) Glass surface — translucent frosted overlay -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_background" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- 3) Primary specular glow — radial highlight at top-left (matches compass compass specular at 0.25,0.15) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.22"
                android:centerY="0.12"
                android:gradientRadius="1.4"
                android:startColor="@color/widget_specular_glow"
                android:endColor="@color/widget_background"
                android:type="radial" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- 4) Secondary glow — subtle Fresnel radiance at bottom-right (matches compass secondary light at 0.72,0.28) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.75"
                android:centerY="0.85"
                android:gradientRadius="1.0"
                android:startColor="@color/widget_fresnel_glow"
                android:endColor="@color/widget_background"
                android:type="radial" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- 5) Border — thin translucent outline -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="@color/widget_outline_variant" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
