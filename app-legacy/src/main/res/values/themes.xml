<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Splash screen starting theme (SplashScreen compat library — Android 12+) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#121212</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/fieldmind_logo</item>
        <item name="windowSplashScreenAnimationDuration">10</item>
        <item name="postSplashScreenTheme">@style/Theme.Rhythm</item>
    </style>

    <!-- Base app theme -->
    <style name="Theme.Rhythm" parent="Theme.AppCompat.NoActionBar">
        <!-- Prevent white flash on startup -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:colorPrimary">@android:color/white</item>
        <item name="colorPrimary">@android:color/white</item>
    </style>

    <!-- Crash recovery theme.
         Isolated from the main app theme so the crash UI always renders with
         a stable light palette, even if the main theme/dynamic colors are
         corrupted or the crash occurs during theme initialization. -->
    <style name="Theme.FieldMind.Crash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorPrimary">@android:color/black</item>
        <item name="colorPrimary">@android:color/black</item>
    </style>
</resources>