<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundDark">

    <!-- Connection UI (shown before connect) -->
    <ScrollView
        android:id="@+id/connectionUI"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕹️  Controller"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect to a target device"
                android:textSize="13sp"
                android:textColor="@color/textMuted"
                android:layout_marginBottom="28dp" />

            <!-- IP Input Card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET IP ADDRESS"
                        android:textSize="11sp"
                        android:textColor="@color/textMuted"
                        android:letterSpacing="0.08" />

                    <EditText
                        android:id="@+id/etTargetIp"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="phone"
                        android:hint="192.168.1.45"
                        android:digits="0123456789."
                        android:layout_marginTop="8dp"
                        android:background="@null"
                        android:textSize="18sp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textMuted"
                        android:paddingHorizontal="0dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="@color/divider" />

                </LinearLayout>

            </FrameLayout>

            <!-- Input Only Toggle -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Input Only Mode"
                            android:textSize="15sp"
                            android:textColor="@color/textPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Keyboard &amp; mouse control without screen sharing"
                            android:textSize="11sp"
                            android:textColor="@color/textMuted"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchInputOnly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent"
                        android:trackTint="@color/divider" />

                </LinearLayout>

            </FrameLayout>

            <!-- Scan Button -->
            <Button
                android:id="@+id/btnScan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🔍  SCAN NEARBY DEVICES"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_button_secondary"
                android:layout_marginBottom="8dp" />

            <!-- Discovered Hosts Card (shown when scan finds devices) -->
            <FrameLayout
                android:id="@+id/discoveredHostsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/discoveredHostsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </FrameLayout>

            <!-- Connect Button -->
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CONNECT"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_button_primary"
                android:layout_marginBottom="16dp" />

            <!-- Status Card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○  Not connected"
                        android:textSize="14sp"
                        android:textColor="@color/statusDisconnected" />

                    <TextView
                        android:id="@+id/tvLatency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your IP: --"
                        android:textSize="13sp"
                        android:textColor="@color/textMuted"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

            </FrameLayout>

            <!-- How To Connect (collapsible info) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📖  How to Connect"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/help_connect_text"
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary"
                        android:lineSpacingMultiplier="1.6" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Mirror View (shown after connect) -->
    <FrameLayout
        android:id="@+id/mirrorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:gravity="center">

        <com.mirror.app.MirrorSurfaceView
            android:id="@+id/mirrorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Cursor + diagnostic overlay (TextureView.draw() is final, so overlay is separate) -->
        <com.mirror.app.CursorOverlayView
            android:id="@+id/cursorOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <!-- Status Bar (top overlay) -->
        <FrameLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_status_bar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvLatencyBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lat: --ms"
                    android:textColor="#A0FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <!-- Ratio toggle in status bar: Fit / Stretch / Fill -->
                <TextView
                    android:id="@+id/btnRatioToggle"
                    android:layout_width="56dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:text="Crop"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvFpsBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="FPS: 0"
                    android:textColor="#A0FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnToggleDpad"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="⊞"
                    android:textSize="16sp"
                    android:background="@drawable/bg_button_secondary"
                    android:textColor="@color/textMuted"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnToggleKeyboard"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="⌨"
                    android:textSize="16sp"
                    android:background="@drawable/bg_button_secondary"
                    android:textColor="@color/textMuted"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnDisconnect"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="✕"
                    android:textSize="16sp"
                    android:background="@drawable/bg_button_danger"
                    android:textColor="@color/white" />

            </LinearLayout>

        </FrameLayout>

        <!-- Navigation Buttons (bottom overlay) -->
        <LinearLayout
            android:id="@+id/navButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- System nav row: Back / Home / Recent -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_status_bar"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/btnNavBack"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:text="◀"
                    android:textColor="@color/textPrimary"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/btnNavHome"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:text="⌂"
                    android:textColor="@color/textPrimary"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/btnNavRecent"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:text="▢"
                    android:textColor="@color/textPrimary"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />
            </LinearLayout>

            <!-- DPAD row: Up / Down / Left / Right (hidden by default) -->
            <LinearLayout
                android:id="@+id/dpadRow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_status_bar"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="32dp"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnDpadUp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:text="▲ Up"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/btnDpadDown"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:text="▼ Down"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/btnDpadLeft"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:text="◄ Left"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/btnDpadRight"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:text="► Right"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
