<?xml version="1.0" encoding="utf-8"?>
<!--
    Curio launcher icon — background layer.
    Solid cream surface (CurioColors.CreamWhite, #FFFBF5). The adaptive-icon
    launcher crops this rectangle to the launcher's shape (circle on most
    launchers, squircle on Pixel, etc.); the visible portion is whatever the
    launcher mask leaves.

    Why a flat color, not a pattern: the foreground (roulette dial) already
    carries all the visual interest. Adding pattern to the background would
    compete with the foreground at small sizes.

    See CURIO_SPEC.md §13.1 + §0.2 for the palette rationale.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFBF5"
        android:pathData="M 0,0 L 108,0 L 108,108 L 0,108 Z" />
</vector>
