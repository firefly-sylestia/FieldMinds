<?xml version="1.0" encoding="utf-8"?>
<!--
    Curio Midnight Signal launcher mark.

    This is a new geometric identity, not a recolor of the former wheel:
    an angular open portal with a bright signal spark. Everything stays inside
    the adaptive safe zone (29..79 in the 108dp viewport) for clean launcher
    masks and small-size rendering.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Electric-blue hexagonal portal frame with a navy cutout. -->
    <path
        android:fillColor="#3D8CFF"
        android:fillType="evenOdd"
        android:pathData="M54,25 L79,39 L79,69 L54,83 L29,69 L29,39 Z M54,36 L68,44 L68,64 L54,72 L40,64 L40,44 Z" />

    <!-- Mint aperture: the open path through the portal. -->
    <path
        android:fillColor="#009E83"
        android:pathData="M54,41 L64,47 L64,61 L54,67 L44,61 L44,47 Z" />

    <!-- Orange signal spark, offset so the mark has forward motion. -->
    <path
        android:fillColor="#E6652F"
        android:pathData="M78,25 L81,30 L86,33 L81,36 L78,41 L75,36 L70,33 L75,30 Z" />

    <!-- Small cream calibration notch. -->
    <path
        android:fillColor="#F8FBFF"
        android:pathData="M51,47 L57,47 L57,61 L51,61 Z" />
</vector>
