<?xml version="1.0" encoding="utf-8"?>
<!--
    Curio launcher icon — foreground layer.

    Redesigned (replaces the wheel-with-pointer in commit 0d5e6b2b). The user
    asked for something that looks like "a shuffle between the topics in a
    beautiful way" — NOT a roulette wheel. This composition is a stacked deck
    of three topic cards: the front card shows the topic representation
    (image placeholder + title bar + subtitle bar), the two behind peek out
    at the top-left to suggest depth and choice (like a hand of cards being
    riffled).

    Composition (see CURIO_SPEC.md §0.2 palette + §13.1 icon logomark):
      1. Card 1 (BACK, peeks out top + left):  Lilac      #C9A6F2
      2. Card 2 (MIDDLE, peeks out top + left): Sky Mint   #8FE3CF
      3. Card 3 (FRONT, the "current" card):    Cream White #FFFBF5
         Inside the front card:
         - Image placeholder: Butter Yellow #FFD97D rounded rect
         - Title bar:         Deep Plum #3B0A17 (the §0.2 on-primary text color)
         - Subtitle bar:      Soft Sand #F6EFE4 (the §0.2 surface-container)
         - Sparkle:           Deep Plum 4-point star on the image area
      4. No pointer, no wheel, no gradient — the deck IS the metaphor.

    Geometry: each card is 56w x 64h with 6dp rounded corners. They share
    the same shape but are offset (10dp left, 4dp up between cards) so each
    back card peeks out behind the front one. Center of the deck sits at
    (54, 56) — slightly below viewport center to balance the sparkle which
    sits at the top of the front card. Safe-zone check: outermost edge
    (Card 1 top-left at 4, 16) sits at distance ~62 from viewport center —
    this is OUTSIDE the 33dp safe zone, which is intentional: launcher masks
    crop the corners anyway, so the deck will look like it's spilling out
    the back-left, reinforcing the "stack" silhouette. The FRONT card's
    visible area stays well inside the safe zone.

    Palette uses primary sub-accents (butter yellow + sky mint + lilac on
    coral), NOT the secondary category palette — the category colors
    (#C9A6F2 / #9BB8E8 / #A8C99A / #FFB585 / #6FC7BE) are reserved for the
    in-app category chips. The icon uses neutral-feeling warm-pastels that
    hint at the category palette without consuming it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Card 1 (back): Lilac, peeks out top-left ─────────────────── -->
    <path android:fillColor="#C9A6F2"
          android:pathData="M 10,16 L 54,16 A 6,6 0 0,1 60,22 L 60,74 A 6,6 0 0,1 54,80 L 10,80 A 6,6 0 0,1 4,74 L 4,22 A 6,6 0 0,1 10,16 Z" />

    <!-- ── Card 2 (middle): Sky Mint, peeks out top-left ───────────── -->
    <path android:fillColor="#8FE3CF"
          android:pathData="M 22,20 L 66,20 A 6,6 0 0,1 72,26 L 72,78 A 6,6 0 0,1 66,84 L 22,84 A 6,6 0 0,1 16,78 L 16,26 A 6,6 0 0,1 22,20 Z" />

    <!-- ── Card 3 (front): Cream, the "current topic" ──────────────── -->
    <path android:fillColor="#FFFBF5"
          android:pathData="M 32,24 L 76,24 A 6,6 0 0,1 82,30 L 82,82 A 6,6 0 0,1 76,88 L 32,88 A 6,6 0 0,1 26,82 L 26,30 A 6,6 0 0,1 32,24 Z" />

    <!-- ── Image placeholder (butter yellow, rounded) ─────────────── -->
    <path android:fillColor="#FFD97D"
          android:pathData="M 42,32 L 66,32 A 4,4 0 0,1 70,36 L 70,56 A 4,4 0 0,1 66,60 L 42,60 A 4,4 0 0,1 38,56 L 38,36 A 4,4 0 0,1 42,32 Z" />

    <!-- ── Title bar (deep plum) ────────────────────────────────────── -->
    <path android:fillColor="#3B0A17"
          android:pathData="M 38,65 L 62,65 L 62,68 L 38,68 Z" />

    <!-- ── Subtitle bar (soft sand) ────────────────────────────────── -->
    <path android:fillColor="#F6EFE4"
          android:pathData="M 38,72 L 54,72 L 54,74 L 38,74 Z" />

    <!-- ── Sparkle (4-point star, deep plum, on image area) ─────────── -->
    <path android:fillColor="#3B0A17"
          android:pathData="M 74,26 L 76,28 L 78,30 L 76,32 L 74,34 L 72,32 L 70,30 L 72,28 Z" />
</vector>