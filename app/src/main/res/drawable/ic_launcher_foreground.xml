<?xml version="1.0" encoding="utf-8"?>
<!--
    Curio launcher icon — foreground layer.

    Polish iteration on commit 5ad5fc2d. Three reviewer-recommended fixes:

      1. ROTATION: back cards now tilted via <group android:rotation=...>
         so the deck reads as "being shuffled" rather than "neatly stacked".
            Card 1 (back):   rotated -6 deg around its center (32, 48)
            Card 2 (middle): rotated +4 deg around its center (44, 52)
            Card 3 (front):  no rotation (focal point)
      2. THICKER BARS: title 24x3 -> 24x5 and subtitle 16x2 -> 16x4 so they
         survive 24dp launcher scaling (5dp+ at 4.5x scale is legible).
      3. CATEGORY PALETTE: Card 1 swapped from Lilac (#C9A6F2, primary
         sub-accent) to Dusty Blue (#9BB8E8, Movies). Card 2 keeps Lilac
         (Music). Card 3 stays Cream. Both back cards now use the actual
     in-app category palette per CURIO_SPEC.md section 0.2 — stronger
     brand consistency at the launcher level than primary sub-accents.

    Composition (unchanged structure):
      1. Card 1 (back, peeks top+left):   Dusty Blue #9BB8E8 (Movies)
      2. Card 2 (middle, peeks top+left): Lilac      #C9A6F2 (Music)
      3. Card 3 (front, focal point):     Cream White #FFFBF5
         Inside the front card:
         - Image placeholder: Butter Yellow #FFD97D rounded rect
         - Title bar:         Deep Plum #3B0A17 (5dp thick)
         - Subtitle bar:      Soft Sand  #F6EFE4 (4dp thick)
         - Sparkle:           Deep Plum 4-point star on image area

    Geometry: each card is 56w x 64h with 6dp rounded corners. Card
    centers at (32, 48), (44, 52), (54, 56). Card 1 edges extend slightly
    outside the 33dp safe zone after rotation; launcher masks crop them
    into the silhouette, which is intentional (the deck "spills out" the
    back-left corner).

    Palette note: Card 3 stays Cream (NOT a category color) because it's
    the "current topic" card and needs to show the image/title/subtitle
    content legibly. Using a category color for Card 3 would clash with
    the image placeholder.

    NO gradients — per CURIO_SPEC.md section 0.2, gradients are Wildcard-
    only.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Card 1 (back): Dusty Blue (Movies), rotated -6 deg ──────── -->
    <group android:pivotX="32" android:pivotY="48" android:rotation="-6">
        <path android:fillColor="#9BB8E8"
              android:pathData="M 10,16 L 54,16 A 6,6 0 0,1 60,22 L 60,74 A 6,6 0 0,1 54,80 L 10,80 A 6,6 0 0,1 4,74 L 4,22 A 6,6 0 0,1 10,16 Z" />
    </group>

    <!-- ── Card 2 (middle): Lilac (Music), rotated +4 deg ──────────── -->
    <group android:pivotX="44" android:pivotY="52" android:rotation="4">
        <path android:fillColor="#C9A6F2"
              android:pathData="M 22,20 L 66,20 A 6,6 0 0,1 72,26 L 72,78 A 6,6 0 0,1 66,84 L 22,84 A 6,6 0 0,1 16,78 L 16,26 A 6,6 0 0,1 22,20 Z" />
    </group>

    <!-- ── Card 3 (front): Cream, the "current topic" (no rotation) ─── -->
    <path android:fillColor="#FFFBF5"
          android:pathData="M 32,24 L 76,24 A 6,6 0 0,1 82,30 L 82,82 A 6,6 0 0,1 76,88 L 32,88 A 6,6 0 0,1 26,82 L 26,30 A 6,6 0 0,1 32,24 Z" />

    <!-- ── Image placeholder (butter yellow, rounded) ─────────────── -->
    <path android:fillColor="#FFD97D"
          android:pathData="M 42,32 L 66,32 A 4,4 0 0,1 70,36 L 70,56 A 4,4 0 0,1 66,60 L 42,60 A 4,4 0 0,1 38,56 L 38,36 A 4,4 0 0,1 42,32 Z" />

    <!-- ── Title bar (deep plum, 5dp thick for 24dp legibility) ───── -->
    <path android:fillColor="#3B0A17"
          android:pathData="M 38,65 L 62,65 L 62,70 L 38,70 Z" />

    <!-- ── Subtitle bar (soft sand, 4dp thick) ─────────────────────── -->
    <path android:fillColor="#F6EFE4"
          android:pathData="M 38,73 L 54,73 L 54,77 L 38,77 Z" />

    <!-- ── Sparkle (4-point star, deep plum, on image area) ─────────── -->
    <path android:fillColor="#3B0A17"
          android:pathData="M 74,26 L 76,28 L 78,30 L 76,32 L 74,34 L 72,32 L 70,30 L 72,28 Z" />
</vector>