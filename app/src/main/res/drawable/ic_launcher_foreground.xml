<?xml version="1.0" encoding="utf-8"?>
<!--
    Curio gradient-card launcher mark.

    Matches the Spin screen card hierarchy: a solid rounded-rectangle card
    split into two bands — a slightly differentiated DeepPlum-deep on top
    and Lilac below.  Card is centered within the adaptive safe zone (y=30).
    No glyph — the card itself is the mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top band: DeepPlum-deep (#0F2345) — slightly lighter than
         the background (#081B33) so the card shape reads as a whole. -->
    <path
        android:fillColor="#0F2345"
        android:pathData="M42,30 L66,30 A10,10 0 0,1 76,40 L76,56 L32,56 L32,40 A10,10 0 0,1 42,30 Z" />

    <!-- Bottom band: Lilac — the electric signal half of the card. -->
    <path
        android:fillColor="#3D8CFF"
        android:pathData="M32,56 L76,56 L76,72 A10,10 0 0,1 66,82 L42,82 A10,10 0 0,1 32,72 Z" />
</vector>
