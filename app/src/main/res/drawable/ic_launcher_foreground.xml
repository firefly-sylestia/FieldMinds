<?xml version="1.0" encoding="utf-8"?>
<!--
    Curio launcher icon — centered discovery wheel foreground.

    The artwork is intentionally contained inside the adaptive-icon safe zone:
    the wheel spans 44..84 in the 108dp viewport, leaving comfortable space
    for launcher masks, parallax, and small app-icon rendering. The coral
    background supplies the brand field; this layer supplies the cream wheel,
    six category colors, and deep-plum center mark.

    Keep this composition flat and vector-only so it remains crisp at launcher
    size and can be mirrored by the website icon asset.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cream wheel frame: centered at (54,54), radius 32dp. -->
    <path
        android:fillColor="#FFFBF5"
        android:pathData="M54,22 A32,32 0,1 1,53.99,22 Z" />

    <!-- Six category wedges, inset from the cream frame for a clear rim. -->
    <path
        android:fillColor="#C9A6F2"
        android:pathData="M54,54 L54,29 A25,25 0,0 1,75.65,41.5 Z" />
    <path
        android:fillColor="#9BB8E8"
        android:pathData="M54,54 L75.65,41.5 A25,25 0,0 1,75.65,66.5 Z" />
    <path
        android:fillColor="#A8C99A"
        android:pathData="M54,54 L75.65,66.5 A25,25 0,0 1,54,79 Z" />
    <path
        android:fillColor="#FFB585"
        android:pathData="M54,54 L54,79 A25,25 0,0 1,32.35,66.5 Z" />
    <path
        android:fillColor="#6FC7BE"
        android:pathData="M54,54 L32.35,66.5 A25,25 0,0 1,32.35,41.5 Z" />
    <path
        android:fillColor="#FFD97D"
        android:pathData="M54,54 L32.35,41.5 A25,25 0,0 1,54,29 Z" />

    <!-- Deep-plum center: a compact, high-contrast identity at icon size. -->
    <path
        android:fillColor="#3B0A17"
        android:pathData="M54,43 A11,11 0,1 1,53.99,43 Z" />
    <path
        android:fillColor="#FFFBF5"
        android:pathData="M54,48 A6,6 0,1 1,53.99,48 Z" />
</vector>
